:BiDirectionalSwirlCoaxialInjectorElement a owl:Class ;
    skos:prefLabel "bi-directional swirl coaxial injector element"@en ;
    rdfs:comment "Injector element design in which oxidizer flows through a central passage and fuel through an annular passage, with counter-rotating swirl components imparted by tangential oxidizer entry and helical vanes in the fuel passage, often with positive oxidizer-post recess. Used in the seven-element LOx-methane rocket combustor studied here."@en ;
    rdfs:subClassOf :PhysicalObject ;
    skos:exactMatch <https://w3id.org/emmo#BiDirectionalSwirlCoaxialInjectorElement> .

:PhysicalObject a owl:Class ;
    skos:prefLabel "PhysicalObject"@en ;
    prism:alignment "unmatched" ;
    prism:declaredByReference true .

:Process a owl:Class ;
    skos:prefLabel "Process"@en ;
    prism:alignment "unmatched" ;
    prism:declaredByReference true .

:SelfSustainedHighFrequencyCombustionInstabilityLimitCycle a owl:Class ;
    skos:prefLabel "self-sustained high-frequency combustion instability limit cycle"@en ;
    rdfs:comment "Self-sustained, high-amplitude thermoacoustic oscillation (limit cycle) driven by coupling between unsteady heat release and chamber longitudinal acoustic modes, triggered in supercritical LOx-methane combustion when the fuel injection temperature falls below a critical boundary (about 219 K here), accompanied by reduced fuel-to-oxidizer velocity ratio and incomplete combustion signatures."@en ;
    rdfs:subClassOf :Process ;
    skos:exactMatch <https://w3id.org/emmo#SelfSustainedLongitudinalCombustionInstability> .

