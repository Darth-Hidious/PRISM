{
  "name": "prism-vscode",
  "displayName": "Mirdyne PRISM",
  "description": "VS Code client for PRISM materials-science workflows.",
  "version": "1.0.0",
  "publisher": "mirdyne",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darth-Hidious/PRISM.git",
    "directory": "extensions/prism-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "prism",
    "materials-science",
    "llm",
    "workflow"
  ],
  "activationEvents": [
    "onView:prism.agent",
    "onView:prism.context",
    "onView:prism.tools",
    "onView:prism.materials",
    "onCommand:prism.openAgent",
    "onCommand:prism.startBackend",
    "onCommand:prism.refreshMarc27",
    "onCommand:prism.showWelcome"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc -p ./ --noEmit",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.3"
  },
  "contributes": {
    "configuration": {
      "title": "PRISM",
      "properties": {
        "prism.backendCommand": {
          "type": "string",
          "default": "prism",
          "description": "Command used to launch the local PRISM backend."
        },
        "prism.backendArgs": {
          "type": "array",
          "default": [
            "backend"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed before --project-root and --python when launching the backend."
        },
        "prism.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter passed to prism backend."
        },
        "prism.autoStartBackend": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the local backend before sending agent messages."
        },
        "prism.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Automatically approve all tool calls without prompting. Sent to the backend at init; takes effect on the next backend start."
        },
        "prism.welcome.showOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Show the PRISM welcome tab when the window opens."
        },
        "prism.apiBaseUrl": {
          "type": "string",
          "description": "Base URL for the configured provider API. No provider is selected by default."
        },
        "prism.marc27ApiBaseUrl": {
          "type": "string",
          "description": "Deprecated alias for prism.apiBaseUrl."
        },
        "prism.maxStreamingBufferChars": {
          "type": "number",
          "default": 120000,
          "minimum": 20000,
          "description": "Maximum text retained in the Agent view before older stream content is compacted."
        },
        "prism.experimentalMarc27ApiV2": {
          "type": "boolean",
          "default": false,
          "description": "Enable opt-in calls to versioned platform API revamp endpoints as they land."
        }
      }
    },
    "commands": [
      {
        "command": "prism.openAgent",
        "title": "PRISM: Open Agent"
      },
      {
        "command": "prism.startBackend",
        "title": "PRISM: Start Backend"
      },
      {
        "command": "prism.stopBackend",
        "title": "PRISM: Stop Backend"
      },
      {
        "command": "prism.sendSelection",
        "title": "PRISM: Send Selection to Agent"
      },
      {
        "command": "prism.runResearch",
        "title": "PRISM: Run Research Query"
      },
      {
        "command": "prism.queryKnowledge",
        "title": "PRISM: Query Knowledge"
      },
      {
        "command": "prism.openModels",
        "title": "PRISM: Show Models"
      },
      {
        "command": "prism.openWorkflows",
        "title": "PRISM: Show Workflows"
      },
      {
        "command": "prism.refreshMarc27",
        "title": "PRISM: Refresh Platform Capabilities"
      },
      {
        "command": "prism.setMarc27ApiKey",
        "title": "PRISM: Set Platform API Key"
      },
      {
        "command": "prism.clearMarc27ApiKey",
        "title": "PRISM: Clear Platform API Key"
      },
      {
        "command": "prism.newChat",
        "title": "PRISM: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "prism.openChatTab",
        "title": "PRISM: Open Agent Chat Tab",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "prism.toggleAutoApprove",
        "title": "PRISM: Toggle Auto-Approve"
      },
      {
        "command": "prism.askAboutFile",
        "title": "PRISM: Ask Agent About This File"
      },
      {
        "command": "prism.setModel",
        "title": "PRISM: Set Agent Model"
      },
      {
        "command": "prism.marketplaceSearch",
        "title": "PRISM: Search Marketplace",
        "icon": "$(search)"
      },
      {
        "command": "prism.marketplaceInstall",
        "title": "PRISM: Install from Marketplace",
        "icon": "$(cloud-download)"
      },
      {
        "command": "prism.marketplaceFind",
        "title": "PRISM: Discover Marketplace by Capability"
      },
      {
        "command": "prism.refreshTools",
        "title": "PRISM: Refresh Agent Tools",
        "icon": "$(refresh)"
      },
      {
        "command": "prism.meshHealth",
        "title": "PRISM Mesh: Health"
      },
      {
        "command": "prism.meshPeers",
        "title": "PRISM Mesh: List Peers"
      },
      {
        "command": "prism.meshDiscover",
        "title": "PRISM Mesh: Discover Peers"
      },
      {
        "command": "prism.listNodes",
        "title": "PRISM: List Platform Nodes"
      },
      {
        "command": "prism.accountStatus",
        "title": "PRISM: Account Status"
      },
      {
        "command": "prism.signIn",
        "title": "PRISM: Sign In"
      },
      {
        "command": "prism.signOut",
        "title": "PRISM: Sign Out"
      },
      {
        "command": "prism.openPeriodicTable",
        "title": "PRISM: Open Periodic Table",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "prism.searchMaterials",
        "title": "PRISM: Search Materials",
        "icon": "$(search)"
      },
      {
        "command": "prism.askAboutComposition",
        "title": "PRISM: Ask Agent About Composition",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "prism.showWelcome",
        "title": "PRISM: Show Welcome"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "prism.sendSelection",
          "when": "editorHasSelection",
          "group": "navigation@90"
        },
        {
          "command": "prism.askAboutFile",
          "group": "prism"
        }
      ],
      "view/title": [
        {
          "command": "prism.newChat",
          "when": "view == prism.agent",
          "group": "navigation"
        },
        {
          "command": "prism.openChatTab",
          "when": "view == prism.agent",
          "group": "navigation"
        },
        {
          "command": "prism.refreshTools",
          "when": "view == prism.tools",
          "group": "navigation"
        },
        {
          "command": "prism.searchMaterials",
          "when": "view == prism.materials",
          "group": "navigation"
        },
        {
          "command": "prism.askAboutComposition",
          "when": "view == prism.materials",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prism",
          "title": "PRISM",
          "icon": "resources/prism.svg"
        }
      ]
    },
    "views": {
      "prism": [
        {
          "id": "prism.agent",
          "name": "Agent",
          "type": "webview"
        },
        {
          "id": "prism.context",
          "name": "Context"
        },
        {
          "id": "prism.tools",
          "name": "Agent Tools"
        },
        {
          "id": "prism.materials",
          "name": "Materials Explorer",
          "type": "webview"
        },
        {
          "id": "prism.models",
          "name": "Models"
        },
        {
          "id": "prism.workflows",
          "name": "Workflows"
        },
        {
          "id": "prism.jobs",
          "name": "Jobs"
        },
        {
          "id": "prism.billing",
          "name": "Billing"
        }
      ]
    }
  }
}
