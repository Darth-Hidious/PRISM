# PRISM v2.0 Environment Configuration
# Copy to .env and fill in your API keys.

# --- Hosted platform (optional) ---
# PRISM has no default hosted endpoint. Configure both values to connect to a
# provider; otherwise PRISM runs local-only and reports "no platform configured".
# PRISM_API_URL=https://provider.example/api/v1
# PRISM_API_KEY=your-provider-api-key
# For session credentials, use PRISM_TOKEN or PRISM_API_TOKEN instead.
#
# Deprecated compatibility aliases remain accepted with a warning:
# MARC27_API_URL, MARC27_PLATFORM_URL, MARC27_API_KEY, MARC27_TOKEN,
# MARC27_API_TOKEN. Every PRISM-native name wins over every deprecated alias.

# --- LLM Providers (at least one required) ---

# OpenAI
# OPENAI_API_KEY=your-api-key-here

# Anthropic
# ANTHROPIC_API_KEY=your-api-key-here

# Google Vertex AI
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# OpenRouter (access to 200+ models with a single key)
# OPENROUTER_API_KEY=your-api-key-here

# --- Hosted chat model (two separate axes) ---
# The same model can be served by more than one provider at different
# prices and billing routes (e.g. claude-sonnet-5 direct from Anthropic
# vs via OpenRouter). LLM_PROVIDER picks the serving provider,
# LLM_MODEL picks the model; the pair is resolved against the platform
# model catalog. Leave both unset to use the platform's default model.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5

# --- Data Sources ---

# Materials Project API key (optional, for enriched properties)
# MATERIALS_PROJECT_API_KEY=your-mp-api-key-here
